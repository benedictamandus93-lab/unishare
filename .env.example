# Supabase Dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys -> anon / publishable key
# This key is safe to expose in the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Never place SUPABASE_SERVICE_ROLE_KEY in this project or in GitHub.
